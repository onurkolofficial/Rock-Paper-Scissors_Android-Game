    <string name="notifications_v410_title">Version 4.1.0.31 - System &amp; Content Update</string>
    <string name="notifications_v410_f1">• Core Update: Native Compose architecture directly compatible with the system</string>
    <string name="notifications_v410_f2">• New Notification System: System announcements and changelog history</string>
    <string name="notifications_v410_f3">• In-App Update System: Direct update downloader via Google Play</string>
    <string name="notifications_v410_f4">• Hard/Classic Online Modes: Matchmaking with or without special items</string>
    <string name="notifications_v410_f5">• Room Creation Item Toggle: Enable/disable special items in private rooms</string>
    <string name="notifications_v410_f6">• User Profile System: Online stats, win rate and recent match history</string>
    <string name="notifications_v410_f7">• Game Rules: Mode guides, 5-round forfeit rule, and move matrix</string>
    <string name="notifications_v410_f8">• New Skin &amp; Special Items: Royal Gold skin, Fire, Lightning, and Bomb</string>
    <string name="notifications_v410_f9">• Performance improvements and bug fixes</string>
    <string name="notifications_v400_title">Version 4.0.0.30 - Native Core &amp; Multiplayer Update</string>
    <string name="notifications_v400_f1">• Game Core Updated: It is no longer web-based; it is now a core update compatible directly with the system.</string>
    <string name="notifications_v400_f2">• Online Multiplayer: Play with players from all over the world with Classic and Hard modes!</string>
    <string name="notifications_v400_f3">• Special Skins: Customize your hand looks from the shop, now fully visible online.</string>
    <string name="notifications_v400_f4">• Special Items: Buy and use Iron, Ice, and Steel to defeat opponents.</string>
    <string name="notifications_v400_f5">• Play Games Sync: Progress automatically saved using Google Play Games Snapshot.</string>
    <string name="notifications_v400_f6">• UI Improvements: Smoother animations, player profiles, and game rules modal.</string>
    <string name="notifications_v150_title">Version 1.5.0 - Store &amp; Powers</string>
    <string name="notifications_v150_f1">• In-game Shop with custom Skins</string>
    <string name="notifications_v150_f2">• Special consumable moves (Iron, Ice, Steel)</string>
    <string name="notifications_v120_title">Version 1.2.0 - Play Games Integration</string>
    <string name="notifications_v120_f1">• Google Play Games Cloud Saves &amp; Silent Sign-in</string>
    <string name="notifications_v120_f2">• Leaderboards and Achievements tracking</string>
    <string name="notifications_v100_title">Version 1.0.0 - Initial Launch</string>
    <string name="notifications_v100_f1">• Single Player AI battles &amp; Local Two Player mode</string>
